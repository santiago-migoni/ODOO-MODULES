<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="snippet_formal_header">
        <div class="dipl_quote_header">
            <div class="row align-items-start dipl_quote_header_top">
                <div class="col-7">
                    <img
                        t-if="doc.company_id.logo"
                        t-att-src="image_data_uri(doc.company_id.logo)"
                        alt="Logo"
                        class="dipl_quote_logo"
                    />
                    <div class="dipl_quote_company_name">
                        <span t-field="doc.company_id.name"/>
                    </div>
                    <div class="dipl_quote_company_data">
                        <span t-if="doc.company_id.partner_id.street" t-out="doc.company_id.partner_id.street"/>
                        <t t-if="doc.company_id.partner_id.street2">
                            <span t-if="doc.company_id.partner_id.street"> - </span>
                            <span t-out="doc.company_id.partner_id.street2"/>
                        </t>
                        <t t-if="doc.company_id.partner_id.city">
                            <br/>
                            <span t-out="doc.company_id.partner_id.city"/>
                            <t t-if="doc.company_id.partner_id.state_id">
                                <span t-out="', %s' % doc.company_id.partner_id.state_id.name"/>
                            </t>
                            <t t-if="doc.company_id.partner_id.zip">
                                <span t-out="' (%s)' % doc.company_id.partner_id.zip"/>
                            </t>
                        </t>
                        <t t-if="doc.company_id.partner_id.phone or doc.company_id.partner_id.mobile">
                            <br/>
                            <span t-out="doc.company_id.partner_id.phone or doc.company_id.partner_id.mobile"/>
                        </t>
                        <t t-if="doc.company_id.partner_id.email">
                            <br/>
                            <span t-out="doc.company_id.partner_id.email"/>
                        </t>
                        <t t-if="doc.company_id.partner_id.website">
                            <br/>
                            <span t-out="(doc.company_id.partner_id.website or '').replace('https://', '').replace('http://', '')"/>
                        </t>
                        <t t-if="doc.company_id.partner_id.vat">
                            <br/>
                            <strong>CUIT:</strong>
                            <span t-field="doc.company_id.partner_id.vat"/>
                        </t>
                    </div>
                </div>
                <div class="col-5">
                    <div class="dipl_quote_doc_box">
                        <div class="dipl_quote_doc_title">COTIZACION</div>
                        <div class="dipl_quote_doc_number">
                            <strong>Nro:</strong>
                            <span t-field="doc.name"/>
                        </div>
                        <div class="dipl_quote_doc_date">
                            <strong>Fecha:</strong>
                            <span t-field="doc.date_order" t-options='{"widget": "date"}'/>
                        </div>
                        <div t-if="doc.validity_date" class="dipl_quote_doc_date">
                            <strong>Validez:</strong>
                            <span t-field="doc.validity_date"/>
                        </div>
                    </div>
                </div>
            </div>
            <div class="dipl_quote_legend">
                Documento no válido como factura
            </div>
        </div>
    </template>

    <template id="snippet_formal_customer_block">
        <div class="dipl_quote_panel dipl_quote_customer_panel">
            <div class="dipl_quote_panel_title">Cliente</div>
            <div class="dipl_quote_panel_body">
                <div class="dipl_quote_label_value">
                    <strong>Razón social:</strong>
                    <span t-field="doc.partner_id.commercial_partner_id.name"/>
                </div>
                <div class="dipl_quote_label_value" t-if="doc.partner_id.contact_address_inline">
                    <strong>Domicilio:</strong>
                    <span t-out="doc.partner_id.contact_address_inline"/>
                </div>
                <div class="dipl_quote_label_value" t-if="doc.partner_id.vat">
                    <strong>CUIT / ID:</strong>
                    <span t-field="doc.partner_id.vat"/>
                </div>
                <div class="dipl_quote_label_value" t-if="'l10n_ar_afip_responsibility_type_id' in doc.partner_id._fields and doc.partner_id.l10n_ar_afip_responsibility_type_id">
                    <strong>Condición IVA:</strong>
                    <span t-field="doc.partner_id.l10n_ar_afip_responsibility_type_id"/>
                </div>
                <div class="dipl_quote_label_value" t-if="doc.partner_id.email">
                    <strong>Email:</strong>
                    <span t-field="doc.partner_id.email"/>
                </div>
                <div class="dipl_quote_label_value" t-if="doc.partner_id.phone or doc.partner_id.mobile">
                    <strong>Teléfono:</strong>
                    <span t-out="doc.partner_id.phone or doc.partner_id.mobile"/>
                </div>
            </div>
        </div>
    </template>

    <template id="snippet_formal_meta_block">
        <div class="dipl_quote_panel dipl_quote_meta_panel">
            <div class="dipl_quote_panel_title">Datos comerciales</div>
            <div class="dipl_quote_panel_body">
                <div class="dipl_quote_label_value" t-if="doc.user_id">
                    <strong>Vendedor:</strong>
                    <span t-field="doc.user_id"/>
                </div>
                <div class="dipl_quote_label_value" t-if="doc.client_order_ref">
                    <strong>Referencia del cliente:</strong>
                    <span t-field="doc.client_order_ref"/>
                </div>
                <div class="dipl_quote_label_value" t-if="doc.payment_term_id">
                    <strong>Condición de pago:</strong>
                    <span t-field="doc.payment_term_id.name"/>
                </div>
                <div class="dipl_quote_label_value" t-if="doc.commitment_date">
                    <strong>Fecha de entrega:</strong>
                    <span t-field="doc.commitment_date" t-options='{"widget": "date"}'/>
                </div>
                <div class="dipl_quote_label_value" t-if="doc.incoterm">
                    <strong>Incoterm:</strong>
                    <span t-field="doc.incoterm.code"/>
                    <t t-if="doc.incoterm_location">
                        <span t-out="' - %s' % doc.incoterm_location"/>
                    </t>
                </div>
            </div>
        </div>
    </template>

    <template id="snippet_formal_lines_table">
        <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
        <t t-set="display_discount" t-value="any(l.discount &gt; 0 for l in lines_to_report)"/>
        <t t-set="display_taxes" t-value="any(l._has_taxes() for l in lines_to_report)"/>
        <table class="table table-sm table-borderless dipl_quote_lines_table">
            <thead>
                <tr>
                    <th class="text-start">Descripción</th>
                    <th class="text-end text-nowrap">Cantidad</th>
                    <th class="text-end text-nowrap">Precio unitario</th>
                    <th t-if="display_discount" class="text-end text-nowrap">Desc. %</th>
                    <th t-if="display_taxes" class="text-end">Impuestos</th>
                    <th class="text-end text-nowrap">Importe</th>
                </tr>
            </thead>
            <tbody class="sale_tbody">
                <t t-set="price_field" t-value="'price_total' if doc.company_price_include == 'tax_included' else 'price_subtotal'"/>
                <t t-foreach="lines_to_report" t-as="line">
                    <t t-if="line.display_type == 'line_section'">
                        <tr class="dipl_quote_section_row">
                            <td t-att-colspan="4 + (1 if display_discount else 0) + (1 if display_taxes else 0)">
                                <span t-field="line.name"/>
                            </td>
                        </tr>
                    </t>
                    <t t-elif="line.display_type == 'line_note'">
                        <tr class="dipl_quote_note_row">
                            <td t-att-colspan="4 + (1 if display_discount else 0) + (1 if display_taxes else 0)">
                                <span t-field="line.name"/>
                            </td>
                        </tr>
                    </t>
                    <t t-elif="not line.display_type">
                        <tr>
                            <td class="text-start">
                                <span t-field="line.name"/>
                            </td>
                            <td class="text-end text-nowrap">
                                <span t-field="line.product_uom_qty"/>
                                <span t-field="line.product_uom_id"/>
                            </td>
                            <td class="text-end text-nowrap">
                                <span t-field="line.price_unit"/>
                            </td>
                            <td t-if="display_discount" class="text-end text-nowrap">
                                <span t-if="line.discount &gt; 0" t-field="line.discount"/>
                            </td>
                            <td t-if="display_taxes" t-attf-class="text-end {{ 'text-nowrap' if len(', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)) &lt; 18 else '' }}">
                                <span t-out="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
                            </td>
                            <td class="text-end text-nowrap">
                                <span t-if="price_field == 'price_subtotal'" t-field="line.price_subtotal"/>
                                <span t-else="" t-field="line.price_total"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
    </template>

    <template id="snippet_formal_totals">
        <div class="dipl_quote_totals_wrap">
            <table class="table table-sm table-borderless dipl_quote_totals_table">
                <t t-call="sale.document_tax_totals">
                    <t t-set="tax_totals" t-value="doc.tax_totals"/>
                    <t t-set="currency" t-value="doc.currency_id"/>
                </t>
            </table>
        </div>
    </template>

    <template id="snippet_formal_legal_legend">
        <div class="dipl_quote_footer_legend">
            Esta cotización expresa una propuesta comercial. No constituye comprobante fiscal ni factura válida.
        </div>
    </template>

    <template id="report_saleorder_formal_quote_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/>
            <t t-set="address"><div/></t>
            <t t-set="layout_document_title"><span/></t>
            <div class="page dipl_quote_page">
                <div class="oe_structure"/>
                <style>
                    .dipl_quote_page {
                        font-size: 13px;
                        color: #202020;
                    }
                    .dipl_quote_header {
                        margin-bottom: 1.2rem;
                    }
                    .dipl_quote_logo {
                        max-height: 70px;
                        margin-bottom: 0.45rem;
                    }
                    .dipl_quote_company_name {
                        font-size: 1.18rem;
                        font-weight: 700;
                        letter-spacing: 0.02em;
                        color: #1d3557;
                        margin-bottom: 0.2rem;
                    }
                    .dipl_quote_company_data {
                        font-size: 0.9rem;
                        line-height: 1.45;
                    }
                    .dipl_quote_doc_box {
                        border: 1.5px solid #1d3557;
                        padding: 0.8rem 0.9rem;
                        text-align: right;
                    }
                    .dipl_quote_doc_title {
                        font-size: 1.3rem;
                        font-weight: 800;
                        letter-spacing: 0.05em;
                        color: #1d3557;
                        margin-bottom: 0.55rem;
                    }
                    .dipl_quote_doc_number,
                    .dipl_quote_doc_date {
                        font-size: 0.92rem;
                        margin-bottom: 0.15rem;
                    }
                    .dipl_quote_legend {
                        margin-top: 0.55rem;
                        padding: 0.35rem 0.55rem;
                        border-left: 4px solid #1d3557;
                        background: #eef4fa;
                        font-size: 0.84rem;
                        font-weight: 600;
                        text-transform: uppercase;
                        letter-spacing: 0.03em;
                    }
                    .dipl_quote_panel {
                        border: 1px solid #d6dde6;
                        height: 100%;
                    }
                    .dipl_quote_panel_title {
                        background: #1d3557;
                        color: #fff;
                        font-size: 0.83rem;
                        font-weight: 700;
                        text-transform: uppercase;
                        letter-spacing: 0.04em;
                        padding: 0.45rem 0.65rem;
                    }
                    .dipl_quote_panel_body {
                        padding: 0.7rem 0.75rem 0.8rem;
                        font-size: 0.9rem;
                        line-height: 1.45;
                    }
                    .dipl_quote_label_value {
                        margin-bottom: 0.28rem;
                    }
                    .dipl_quote_lines_table {
                        margin-top: 1rem;
                    }
                    .dipl_quote_lines_table thead th {
                        border-bottom: 2px solid #1d3557;
                        color: #1d3557;
                        font-size: 0.82rem;
                        font-weight: 700;
                        text-transform: uppercase;
                        letter-spacing: 0.03em;
                        padding-top: 0.45rem;
                        padding-bottom: 0.42rem;
                    }
                    .dipl_quote_lines_table tbody td {
                        border-bottom: 1px solid #e6eaef;
                        padding-top: 0.42rem;
                        padding-bottom: 0.42rem;
                        vertical-align: top;
                    }
                    .dipl_quote_section_row td {
                        background: #f3f6fa;
                        color: #1d3557;
                        font-weight: 700;
                        border-bottom: 1px solid #d7e0ea;
                    }
                    .dipl_quote_note_row td {
                        font-style: italic;
                        color: #555;
                    }
                    .dipl_quote_totals_wrap {
                        margin-top: 0.9rem;
                    }
                    .dipl_quote_totals_table {
                        width: 42%;
                        margin-left: auto;
                    }
                    .dipl_quote_totals_table tr:last-child td,
                    .dipl_quote_totals_table tr:last-child th {
                        border-top: 1.5px solid #1d3557;
                        font-weight: 700;
                    }
                    .dipl_quote_notes_title {
                        margin-top: 1rem;
                        margin-bottom: 0.35rem;
                        font-size: 0.86rem;
                        font-weight: 700;
                        text-transform: uppercase;
                        color: #1d3557;
                        letter-spacing: 0.03em;
                    }
                    .dipl_quote_footer_legend {
                        margin-top: 1rem;
                        font-size: 0.82rem;
                        color: #4d5966;
                    }
                </style>

                <t t-call="dipl_doc_sale.snippet_formal_header"/>

                <div class="row g-2">
                    <div class="col-6">
                        <t t-call="dipl_doc_sale.snippet_formal_customer_block"/>
                    </div>
                    <div class="col-6">
                        <t t-call="dipl_doc_sale.snippet_formal_meta_block"/>
                    </div>
                </div>

                <t t-call="dipl_doc_sale.snippet_formal_lines_table"/>
                <t t-call="dipl_doc_sale.snippet_formal_totals"/>

                <div t-if="not is_html_empty(doc.note) or (doc.payment_term_id and not is_html_empty(doc.payment_term_id.note))">
                    <div class="dipl_quote_notes_title">Observaciones y condiciones</div>
                    <div t-if="not is_html_empty(doc.note)">
                        <span
                            t-field="doc.note"
                            t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}"
                        />
                    </div>
                    <p t-if="doc.payment_term_id and not is_html_empty(doc.payment_term_id.note)">
                        <span t-field="doc.payment_term_id.note"/>
                    </p>
                </div>

                <t t-call="dipl_doc_sale.snippet_formal_legal_legend"/>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_saleorder_formal_quote_raw">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="dipl_doc_sale.report_saleorder_formal_quote_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_saleorder_formal_quote">
        <t t-call="dipl_doc_sale.report_saleorder_formal_quote_raw"/>
    </template>

</odoo>

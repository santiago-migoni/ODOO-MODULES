<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dipl_sale_order_line_view_form_readonly_technical" model="ir.ui.view">
        <field name="name">sale.order.line.form.readonly.technical</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_unit']" position="after">
                <field name="dipl_development_mm" invisible="not dipl_is_technical_line"/>
                <field name="dipl_width_mm" invisible="not dipl_is_technical_line"/>
                <field name="dipl_price_per_kg" readonly="1" invisible="not dipl_is_technical_line"/>
                <field name="dipl_kg_mode" invisible="1"/>
                <field name="dipl_kg_total" string="Technical Kilograms" invisible="not dipl_is_technical_line"/>
            </xpath>
        </field>
    </record>
</odoo>

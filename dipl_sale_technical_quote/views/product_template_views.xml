<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dipl_product_template_form_view_technical_quote" model="ir.ui.view">
        <field name="name">product.template.form.technical.quote</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Technical Quotation" name="dipl_technical_quotation">
                    <group>
                        <field name="dipl_is_technical_quote_product"/>
                        <field name="dipl_material_density" invisible="not dipl_is_technical_quote_product"/>
                        <field name="dipl_thickness_mm" invisible="not dipl_is_technical_quote_product"/>
                        <field name="dipl_theoretical_kg" readonly="1" invisible="not dipl_is_technical_quote_product"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
